use Std.Collections.Vector as V

-- Where a cell's text sits within its column.
@pub data CellAlignment = AlignLeft | AlignRight | AlignCenter

-- A width: a number of characters, or a share of the table's width, with
-- borders taken out.
@pub data Width = Fixed Int | Percentage Int

-- How wide a column may be.
@pub data ColumnConstraint =
  -- Not shown at all.
  Hidden
  -- As wide as its widest content, whatever the table's width.
  | ContentWidth
  -- Exactly this wide, padding included.
  | Absolute Width
  -- At least this wide, padding included.
  | LowerBoundary Width
  -- At most this wide, padding included.
  | UpperBoundary Width
  -- Between the two, padding included.
  | Boundaries Width Width

-- How content is fitted into the table's width.
@pub data ContentArrangement =
  -- Every column as wide as its content, whatever the table's width.
  Disabled
  -- Content is wrapped to keep the table within its width.
  | Dynamic
  -- As `Dynamic`, and the table is widened to fill its width.
  | DynamicFullWidth

-- A colour for a cell's text or background.
@pub data Color =
  Reset
  | Black
  | DarkGrey
  | Red
  | DarkRed
  | Green
  | DarkGreen
  | Yellow
  | DarkYellow
